# Plauda backend base URL. Defaults to the hosted API when blank.
BACKEND_API_URL=https://plauda.fastapicloud.dev

# The frontend talks to the backend through BFF routes, so no backend URL is
# exposed to the browser and no CORS configuration is required.
#
# Public storefront and chat (visitor bearer token):
#   GET  /public/chat/:slug/meta
#   POST /public/chat/:slug/conversations
#   GET  /public/conversations/:id/messages
#   POST /public/chat/:slug/messages              (SSE)
#   GET  /public/conversations/:id/stream         (SSE)
#   POST /public/conversations/:id/handoff
#
# Merchant auth (bearer token stored in browser localStorage):
#   POST /auth/login
#   POST /auth/register
#   GET  /auth/me
#
# Merchant workspace (proxied by /api/merchant/*):
#   GET  /dashboard/summary
#   GET  /orders, GET /orders/:id
#   POST /orders/:id/cancel, /orders/:id/fulfill, /orders/:id/payment-link
#   GET  /orders/:id/audit
#   GET/POST/PATCH/DELETE /products and /products/:id/variants
#   GET/POST/PATCH/DELETE /delivery-zones
#   GET  /business-info, PUT /business-info/:source
#   GET/PATCH /settings
#   GET/POST/DELETE /settings/paypal
#   GET  /conversations, GET /conversations/:id
#   GET  /conversations/:id/messages
#   POST /conversations/:id/accept, /return-to-ai, /close, /messages
#   GET  /conversations/stream                    (SSE)
