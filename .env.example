# Point the Next.js API layer at the Plauda backend.
# Leave this blank to run against the built-in demo data.
#
# The API layer expects these backend routes:
#   GET  {BACKEND_API_URL}/stores/:slug
#   POST {BACKEND_API_URL}/stores/:slug/chat   { message, sessionId? }
#   GET  {BACKEND_API_URL}/orders/:id
#   POST {BACKEND_API_URL}/orders/:id/pay
#
# The pay response can either confirm the payment or return an approval URL:
#   { order, payment: { status: 'paid' | 'pending', approvalUrl?, paidAt?, paypalId? } }
#
# Response shapes are defined in lib/types.ts.
BACKEND_API_URL=
# Optional bearer token sent to the backend.
BACKEND_API_KEY=
